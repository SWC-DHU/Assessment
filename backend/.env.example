# Default LLM connection settings (used when Agent Profile leaves base_url / api_key / model blank)
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
LLM_REQUEST_BUDGET=2
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_TOTAL_BYTES=62914560

# Server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7878

# SQLite & Upload Storage
DATABASE_URL=sqlite:///./playground.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
