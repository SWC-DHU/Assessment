@prefix m: <https://assessment.example.org/ontology/manufacturing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://assessment.example.org/ontology/manufacturing> a owl:Ontology ;
    owl:versionInfo "3.0.0" ;
    owl:versionIRI <https://assessment.example.org/ontology/manufacturing/3.0.0> .

m:Product a owl:Class ; rdfs:label "产品"@zh ; rdfs:comment "制造需求所描述的产品或子产品。"@zh .
m:Material a owl:Class ; rdfs:label "物料"@zh ; rdfs:comment "工序使用或产出的有形材料、零件及半成品。"@zh .
m:Operation a owl:Class ; rdfs:label "工序"@zh ; rdfs:comment "可识别的制造活动，具有来源声明的顺序、输入和输出。"@zh .
m:CapabilityRequirement a owl:Class ; rdfs:label "制造能力需求"@zh ;
    rdfs:comment "工序需要的制造功能，以受控编码聚合同义术语。"@zh .
m:Constraint a owl:Class ; rdfs:label "约束"@zh ;
    rdfs:comment "对明确对象施加的定量边界、工艺条件或质量要求。"@zh .
m:Objective a owl:Class ; rdfs:label "目标"@zh ; rdfs:comment "需求中明确提出的建模、匹配、验证或其他目标。"@zh .

m:MaterialState a owl:Class ; rdfs:label "物料状态"@zh ;
    rdfs:comment "对有形基础物料的阶段或状态限定。"@zh .
m:ProductionLine a owl:Class ; rdfs:label "整线"@zh ; rdfs:comment "整线约束的作用范围。"@zh .
